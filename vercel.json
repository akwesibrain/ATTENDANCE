{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|face-models/|icons/)(?!.*\\.(?:js|mjs|css|map|json|webmanifest|svg|png|jpg|jpeg|webp|gif|ico|woff2?|ttf)$).*)",
      "destination": "/index.html"
    }
  ]
}
